  "cpu": "12th Gen Intel(R) Core(TM) i9-12900K",
  "items": [
    {
      "item": 1,
      "change": "Fair background pending order: new/changed paths before oldest expired verification",
      "regression": "index_progress_test.go"
    },
    {
      "item": 2,
      "change": "One buffer per workspace fingerprint operation",
      "regression": "workspace_test.go; BenchmarkWorkspaceDigest"
    },
    {
      "item": 3,
      "change": "Watcher-owned bounded dirty paths; trusted coverage required; full fallback on policy/errors/gaps/periodic reconciliation",
      "regression": "index_refresh_test.go"
    },
    {
      "item": 4,
      "change": "Installed transcript blocks and line viewport update only the changed suffix",
      "regression": "transcript_blocks_test.go; transcript_viewport_test.go"
    },
    {
      "item": 5,
      "change": "Bounded streaming source hash/line count and at most 32 ephemeral per-validation observations",
      "regression": "source_receipt_test.go; citation history/native/compatible regressions"
    },
    {
      "item": 6,
      "change": "Serialized footprint remains authoritative; remove duplicate history/tool-body JSON from planning shares; decode only tools when sizing schemas",
      "regression": "context_allocation_test.go; prepared_request_test.go; image_budget_test.go"
    },
    {
      "item": 7,
      "change": "Cancelable generation-guarded async conversation load; initial visual64turn page, full local selection/search; bounded loading preview and error handling",
      "regression": "transcript_history_test.go; loading_preview_test.go"
    },
    {
      "item": 8,
      "change": "Message-owned reusable projection DB with private path/identity validation, cancellation and shutdown",
      "regression": "owner_test.go; search_index_test.go; message_projection_test.go"
    },
    {
      "item": 9,
      "change": "Pure source interval parsing and direct resize command contract replace multi-output pointer helpers",
      "regression": "source_receipt_test.go; TUI layout/resize integration"
    },
    {
      "item": 10,
      "change": "One Markdown style config and renderer per used width per call, without mutable global cache",
      "regression": "markdown_reuse_test.go"
    },
    {
      "item": 11,
      "change": "Growing response, cache overflow, image/context, session load, delta/policy/periodic index fixtures; standard-library paired allocation comparison gate",
      "regression": "scripts/bench-compare/main_test.go; benchmark fixtures"
    }
  ],
