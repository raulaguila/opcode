{
  "$schema": "https://raw.githubusercontent.com/raulaguila/opcode/develop/opcode-schema.json",
  "schemaVersion": 1,
  "providerProfiles": {
    "ollama": {
      "name": "Ollama local",
      "backend": "local",
      "baseURL": "http://127.0.0.1:11434/v1",
      "api": "ollama",
      "defaultMaxTokens": 2048,
      "disabled": false
    },
    "lmstudio": {
      "name": "LM Studio local",
      "backend": "local",
      "baseURL": "http://127.0.0.1:1234/v1",
      "api": "chat_completions",
      "defaultMaxTokens": 2048,
      "disabled": true
    },
    "openai": {
      "name": "OpenAI",
      "backend": "openai",
      "baseURL": "https://api.openai.com/v1",
      "api": "responses",
      "apiKeyEnv": "OPENAI_API_KEY",
      "disabled": true
    },
    "anthropic": {
      "name": "Anthropic",
      "backend": "anthropic",
      "baseURL": "https://api.anthropic.com",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "disabled": true
    }
  },
  "tui": {
    "theme": "opcode",
    "sidebar": "hidden",
    "language": "en",
    "notifications": "off",
    "proseWidth": 0
  },
  "preferences": {
    "resumeLast": false,
    "showProcess": false
  },
  "runtime": {
    "webSearch": false,
    "mode": "execute"
  },
  "security": {
    "sandbox": "bubblewrap"
  },
  "index": {
    "background": true,
    "maxFiles": 20000,
    "maxFileBytes": 262144,
    "maxTextBytes": 20971520,
    "memoryMiB": 32,
    "updateSeconds": 5
  }
}
