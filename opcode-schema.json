{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "agent": {
      "description": "Agent configuration",
      "properties": {
        "maxTokens": {
          "description": "Maximum tokens for the agent",
          "minimum": 1,
          "type": "integer"
        },
        "model": {
          "description": "Model ID for the agent",
          "type": "string"
        },
        "reasoningEffort": {
          "description": "Reasoning effort for models that support it (OpenAI, Anthropic)",
          "enum": [
            "none",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh"
          ],
          "type": "string"
        }
      },
      "required": [
        "model"
      ],
      "type": "object"
    }
  },
  "description": "Configuration schema for the Opcode application",
  "properties": {
    "agents": {
      "additionalProperties": {
        "description": "Agent configuration",
        "properties": {
          "maxTokens": {
            "description": "Maximum tokens for the agent",
            "minimum": 1,
            "type": "integer"
          },
          "model": {
            "description": "Model ID for the agent",
            "type": "string"
          },
          "reasoningEffort": {
            "description": "Reasoning effort for models that support it (OpenAI, Anthropic)",
            "enum": [
              "none",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh"
            ],
            "type": "string"
          }
        },
        "required": [
          "model"
        ],
        "type": "object"
      },
      "description": "Agent configurations",
      "properties": {
        "coder": {
          "$ref": "#/definitions/agent"
        },
        "task": {
          "$ref": "#/definitions/agent"
        },
        "title": {
          "$ref": "#/definitions/agent"
        }
      },
      "type": "object"
    },
    "checks": {
      "additionalProperties": {
        "properties": {
          "command": {
            "minLength": 1,
            "type": "string"
          },
          "timeout": {
            "default": 60000,
            "maximum": 600000,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "description": "Named verification commands; every execution still requires command permission.",
      "type": "object"
    },
    "contextPaths": {
      "default": [
        ".github/copilot-instructions.md",
        ".cursorrules",
        ".cursor/rules/",
        "CLAUDE.md",
        "CLAUDE.local.md",
        "opcode.md",
        "opcode.local.md",
        "Opcode.md",
        "Opcode.local.md",
        "OPCODE.md",
        "OPCODE.local.md"
      ],
      "description": "Context paths for the application",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "data": {
      "description": "Storage configuration",
      "properties": {
        "directory": {
          "default": ".opcode",
          "description": "Directory where application data is stored",
          "type": "string"
        }
      },
      "required": [
        "directory"
      ],
      "type": "object"
    },
    "debug": {
      "default": false,
      "description": "Enable debug mode",
      "type": "boolean"
    },
    "debugLSP": {
      "default": false,
      "description": "Enable LSP debug mode",
      "type": "boolean"
    },
    "extensions": {
      "description": "Trusted user-global configuration only. Repository configuration cannot enable skills or hooks.",
      "properties": {
        "hooks": {
          "items": {
            "properties": {
              "command": {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              "event": {
                "enum": [
                  "before_tool",
                  "after_tool"
                ],
                "type": "string"
              },
              "timeout_seconds": {
                "maximum": 30,
                "minimum": 0,
                "type": "integer"
              },
              "tool": {
                "maxLength": 100,
                "type": "string"
              }
            },
            "required": [
              "event",
              "command"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "type": "array"
        },
        "skills": {
          "items": {
            "description": "Absolute skill directory.",
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        }
      },
      "type": "object"
    },
    "index": {
      "description": "Derived index resource limits. Embeddings only come from trusted user-global configuration.",
      "properties": {
        "background": {
          "default": true,
          "type": "boolean"
        },
        "embeddings": {
          "description": "Explicit user-global local embedding service. Never downloads weights.",
          "properties": {
            "endpoint": {
              "description": "HTTP loopback IP URL ending /api/embed; redirects/auth/query are rejected.",
              "type": "string"
            },
            "model": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "endpoint",
            "model"
          ],
          "type": "object"
        },
        "maxFileBytes": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 262144,
              "minimum": 1024
            }
          ],
          "default": 262144,
          "type": "integer"
        },
        "maxFiles": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 20000,
              "minimum": 1
            }
          ],
          "default": 20000,
          "type": "integer"
        },
        "maxTextBytes": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 20971520,
              "minimum": 1024
            }
          ],
          "default": 20971520,
          "type": "integer"
        },
        "memoryMiB": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 128,
              "minimum": 4
            }
          ],
          "default": 32,
          "type": "integer"
        },
        "updateSeconds": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 30,
              "minimum": 1
            }
          ],
          "default": 5,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "lsp": {
      "additionalProperties": {
        "anyOf": [
          {
            "properties": {
              "type": {
                "enum": [
                  "stdio"
                ]
              }
            },
            "required": [
              "command"
            ]
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "sse",
                  "http"
                ]
              }
            },
            "required": [
              "type",
              "url"
            ]
          }
        ],
        "description": "LSP configuration for a language",
        "properties": {
          "args": {
            "description": "Command arguments for the LSP server",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "command": {
            "description": "Command to execute for the LSP server",
            "type": "string"
          },
          "disabled": {
            "default": false,
            "description": "Whether the LSP is disabled",
            "type": "boolean"
          },
          "fileTypes": {
            "description": "Language IDs or extensions for lazy activation; known commands have presets.",
            "items": {
              "maxLength": 80,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          },
          "options": {
            "description": "Additional options for the LSP server",
            "type": "object"
          },
          "rootMarkers": {
            "description": "Relative marker filenames between source directory and workspace root.",
            "items": {
              "maxLength": 160,
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          }
        },
        "type": "object"
      },
      "description": "Language Server Protocol configurations",
      "type": "object"
    },
    "mcpServers": {
      "additionalProperties": {
        "anyOf": [
          {
            "properties": {
              "type": {
                "enum": [
                  "stdio"
                ]
              }
            },
            "required": [
              "command"
            ]
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "sse",
                  "http"
                ]
              }
            },
            "required": [
              "type",
              "url"
            ]
          }
        ],
        "description": "MCP server configuration",
        "properties": {
          "args": {
            "description": "Command arguments for the MCP server",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "command": {
            "description": "Command to execute for the MCP server",
            "type": "string"
          },
          "disabled": {
            "default": false,
            "type": "boolean"
          },
          "env": {
            "description": "Environment variables for the MCP server",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "envVars": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Child environment variable to source environment variable name.",
            "type": "object"
          },
          "headers": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "HTTP headers for remote MCP servers",
            "type": "object"
          },
          "headersEnv": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Header name to environment variable name. Values resolve only in memory.",
            "type": "object"
          },
          "oauth": {
            "additionalProperties": false,
            "description": "Explicit MCP HTTP/SSE OAuth. Tokens are stored separately in a private user auth directory.",
            "properties": {
              "clientID": {
                "maxLength": 2048,
                "type": "string"
              },
              "clientSecretEnv": {
                "description": "Environment variable name, never a resolved client secret",
                "type": "string"
              },
              "redirectPort": {
                "default": 0,
                "maximum": 65535,
                "minimum": 0,
                "type": "integer"
              },
              "scopes": {
                "items": {
                  "maxLength": 256,
                  "type": "string"
                },
                "maxItems": 32,
                "type": "array"
              }
            },
            "type": "object"
          },
          "type": {
            "default": "stdio",
            "description": "Type of MCP server",
            "enum": [
              "stdio",
              "sse",
              "http"
            ],
            "type": "string"
          },
          "url": {
            "description": "URL for SSE or Streamable HTTP MCP servers",
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "Model Control Protocol server configurations",
      "type": "object"
    },
    "models": {
      "additionalProperties": {
        "properties": {
          "api": {
            "enum": [
              "chat_completions",
              "responses",
              "ollama"
            ],
            "type": "string"
          },
          "api_model": {
            "minLength": 1,
            "type": "string"
          },
          "can_reason": {
            "type": "boolean"
          },
          "context_auto": {
            "description": "Compatibility flag for older automatic snapshots. Omit context_window to discover provider context without persisting metadata.",
            "type": "boolean"
          },
          "context_estimated": {
            "description": "Context is a conservative fallback rather than server or explicit model metadata.",
            "type": "boolean"
          },
          "context_source": {
            "description": "Legacy context metadata; new automatic selections keep the source in memory only.",
            "type": "string"
          },
          "context_window": {
            "description": "Optional manual override. Omit or use zero to discover context from the provider.",
            "minimum": 0,
            "type": "integer"
          },
          "cost_per_1m_in": {
            "minimum": 0,
            "type": "number"
          },
          "cost_per_1m_in_cached": {
            "minimum": 0,
            "type": "number"
          },
          "cost_per_1m_out": {
            "minimum": 0,
            "type": "number"
          },
          "cost_per_1m_out_cached": {
            "minimum": 0,
            "type": "number"
          },
          "default_max_tokens": {
            "minimum": 1,
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "provider_profile": {
            "description": "Optional named provider connection; backend must match provider.",
            "type": "string"
          },
          "supports_attachments": {
            "type": "boolean"
          },
          "thinking_mode": {
            "enum": [
              "enabled",
              "adaptive"
            ],
            "type": "string"
          }
        },
        "required": [
          "provider",
          "api_model"
        ],
        "type": "object"
      },
      "description": "Model references with automatic context discovery, or explicit manual overrides of model metadata",
      "type": "object"
    },
    "preferences": {
      "properties": {
        "favoriteModels": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "type": "array",
          "uniqueItems": true
        },
        "recentModels": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "type": "array",
          "uniqueItems": true
        },
        "resumeLast": {
          "default": false,
          "type": "boolean"
        },
        "showProcess": {
          "default": false,
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "providerProfiles": {
      "additionalProperties": {
        "properties": {
          "api": {
            "description": "Default transport for discovered models. ollama is available only for local.",
            "enum": [
              "",
              "chat_completions",
              "responses",
              "ollama"
            ],
            "type": "string"
          },
          "apiKey": {
            "description": "API key for the provider",
            "type": "string"
          },
          "apiKeyEnv": {
            "description": "Environment variable containing the API key. Only the variable name is saved.",
            "type": "string"
          },
          "backend": {
            "description": "Protocol/backend, independent of the user-chosen profile ID.",
            "enum": [
              "local",
              "copilot",
              "xai",
              "anthropic",
              "openai",
              "gemini",
              "groq",
              "openrouter",
              "bedrock",
              "azure",
              "vertexai"
            ],
            "type": "string"
          },
          "baseURL": {
            "description": "API base URL for local, OpenAI, Anthropic, Gemini, Groq, OpenRouter or xAI. Used for discovery and inference. LOCAL_ENDPOINT overrides local.",
            "type": "string"
          },
          "contextWindow": {
            "description": "Default context limit for discovered models; zero keeps server/catalog metadata.",
            "minimum": 0,
            "type": "integer"
          },
          "defaultMaxTokens": {
            "description": "Default output limit for discovered models; zero keeps server/catalog metadata.",
            "minimum": 0,
            "type": "integer"
          },
          "disabled": {
            "default": false,
            "description": "Whether the provider is disabled",
            "type": "boolean"
          },
          "name": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "backend"
        ],
        "type": "object"
      },
      "description": "Named connections: multiple endpoints may use the same backend.",
      "propertyNames": {
        "pattern": "^[a-z0-9_-]{1,64}$"
      },
      "type": "object"
    },
    "providers": {
      "additionalProperties": {
        "description": "Provider configuration",
        "properties": {
          "api": {
            "description": "Default transport for discovered models. ollama is available only for local.",
            "enum": [
              "",
              "chat_completions",
              "responses",
              "ollama"
            ],
            "type": "string"
          },
          "apiKey": {
            "description": "API key for the provider",
            "type": "string"
          },
          "apiKeyEnv": {
            "description": "Environment variable containing the API key. Only the variable name is saved.",
            "type": "string"
          },
          "baseURL": {
            "description": "API base URL for local, OpenAI, Anthropic, Gemini, Groq, OpenRouter or xAI. Used for discovery and inference. LOCAL_ENDPOINT overrides local.",
            "type": "string"
          },
          "contextWindow": {
            "description": "Default context limit for discovered models; zero keeps server/catalog metadata.",
            "minimum": 0,
            "type": "integer"
          },
          "defaultMaxTokens": {
            "description": "Default output limit for discovered models; zero keeps server/catalog metadata.",
            "minimum": 0,
            "type": "integer"
          },
          "disabled": {
            "default": false,
            "description": "Whether the provider is disabled",
            "type": "boolean"
          },
          "provider": {
            "description": "Provider type",
            "enum": [
              "local",
              "copilot",
              "xai",
              "anthropic",
              "openai",
              "gemini",
              "groq",
              "openrouter",
              "bedrock",
              "azure",
              "vertexai"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "description": "LLM provider configurations",
      "type": "object"
    },
    "runtime": {
      "additionalProperties": false,
      "properties": {
        "firstTokenTimeout": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 1800,
              "minimum": 1
            }
          ],
          "default": 300,
          "description": "Zero uses the default. Durations are seconds; toolBudget counts bytes of tool content and metadata.",
          "type": "integer"
        },
        "idleTimeout": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 600,
              "minimum": 1
            }
          ],
          "default": 90,
          "description": "Zero uses the default. Durations are seconds; toolBudget counts bytes of tool content and metadata.",
          "type": "integer"
        },
        "maxSeconds": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 7200,
              "minimum": 1
            }
          ],
          "default": 1800,
          "description": "Zero uses the default. Durations are seconds; toolBudget counts bytes of tool content and metadata.",
          "type": "integer"
        },
        "maxSteps": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 200,
              "minimum": 1
            }
          ],
          "default": 32,
          "description": "Zero uses the default. Durations are seconds; toolBudget counts bytes of tool content and metadata.",
          "type": "integer"
        },
        "mode": {
          "default": "execute",
          "enum": [
            "ask",
            "plan",
            "execute"
          ],
          "type": "string"
        },
        "toolBudget": {
          "anyOf": [
            {
              "const": 0
            },
            {
              "maximum": 1048576,
              "minimum": 4096
            }
          ],
          "default": 96000,
          "description": "Zero uses the default. Durations are seconds; toolBudget counts bytes of tool content and metadata.",
          "type": "integer"
        }
      },
      "type": "object"
    },
    "schemaVersion": {
      "description": "Configuration format version; omission preserves legacy compatibility",
      "maximum": 1,
      "minimum": 0,
      "type": "integer"
    },
    "security": {
      "description": "Execution policy from user-global configuration only; repository configuration cannot override it.",
      "properties": {
        "allowNetwork": {
          "default": false,
          "type": "boolean"
        },
        "allowPrivateNetwork": {
          "default": false,
          "type": "boolean"
        },
        "denyPaths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "envAllow": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "readOnlyPaths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sandbox": {
          "default": "bubblewrap",
          "enum": [
            "bubblewrap",
            "none"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "tui": {
      "description": "Terminal User Interface configuration",
      "properties": {
        "keybindings": {
          "additionalProperties": false,
          "properties": {
            "commands": {
              "default": "ctrl+k",
              "pattern": "^(ctrl|alt)\\+[a-z]$",
              "type": "string"
            },
            "files": {
              "default": "ctrl+f",
              "pattern": "^(ctrl|alt)\\+[a-z]$",
              "type": "string"
            },
            "models": {
              "default": "ctrl+o",
              "pattern": "^(ctrl|alt)\\+[a-z]$",
              "type": "string"
            },
            "sessions": {
              "default": "ctrl+s",
              "pattern": "^(ctrl|alt)\\+[a-z]$",
              "type": "string"
            },
            "sidebar": {
              "default": "alt+b",
              "pattern": "^(ctrl|alt)\\+[a-z]$",
              "type": "string"
            },
            "terminal": {
              "default": "ctrl+p",
              "pattern": "^(ctrl|alt)\\+[a-z]$",
              "type": "string"
            },
            "theme": {
              "default": "ctrl+t",
              "pattern": "^(ctrl|alt)\\+[a-z]$",
              "type": "string"
            }
          },
          "type": "object"
        },
        "language": {
          "default": "en",
          "enum": [
            "pt",
            "en"
          ],
          "type": "string"
        },
        "notifications": {
          "default": "off",
          "enum": [
            "off",
            "bell"
          ],
          "type": "string"
        },
        "sidebar": {
          "default": "hidden",
          "enum": [
            "auto",
            "shown",
            "hidden"
          ],
          "type": "string"
        },
        "theme": {
          "default": "opcode",
          "description": "TUI theme name",
          "enum": [
            "opcode",
            "catppuccin",
            "dracula",
            "flexoki",
            "gruvbox",
            "monokai",
            "onedark",
            "tokyonight",
            "tron"
          ],
          "type": "string"
        }
      },
      "type": "object"
    },
    "wd": {
      "description": "Working directory for the application",
      "type": "string"
    }
  },
  "title": "Opcode Configuration",
  "type": "object"
}
